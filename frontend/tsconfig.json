{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    // Typecheck only — Vite does the transpiling. Without this, tsc emitted a
    // .js next to every .ts inside src/, and Vite's default resolve.extensions
    // puts ".js" BEFORE ".ts": an extensionless `@/app/platform` import then
    // resolved to the stale emit. `pnpm build` re-emitted first so it masked
    // itself, but `pnpm dev` and `vitest` silently ran yesterday's code.
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "types": ["vite/client", "vitest/globals"]
  },
  "include": ["src/**/*", "tests/**/*", "plugins/**/*"]
}
